---
/* TableOfContents.astro — そのページの見出しから作る「右側の目次」。
   ・headings は Markdown から自動で得られる（BaseLayout から渡す）。
   ・広い画面では常時表示のパネル、スマホでは折りたたみ（details/summary）。
   ・スクロールに合わせて、今読んでいる見出しを強調する。 */
import type { MarkdownHeading } from "astro";

interface Props {
  /** ページの見出し一覧（depth / slug / text を持つ） */
  headings: MarkdownHeading[];
  /** 目次に載せる見出しの深さの範囲（既定: h2〜h3） */
  minDepth?: number;
  maxDepth?: number;
}

const { headings, minDepth = 2, maxDepth = 3 } = Astro.props;
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
---

{items.length > 0 && (
  <details class="toc" open>
    <summary class="toc-summary">このページの目次</summary>
    <nav class="toc-nav" aria-label="このページの目次">
      <ul class="toc-list">
        {items.map((h) => (
          <li class:list={["toc-item", `depth-${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-slug={h.slug}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  // 目次が無いページでは何もしない
  const toc = document.querySelector<HTMLDetailsElement>(".toc");
  if (toc) {
    // 1) スマホでは初期状態を「閉じる」（折りたたみ）
    if (window.matchMedia("(max-width: 880px)").matches) toc.open = false;

    // 2) スクロール連動ハイライト
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a[data-toc-slug]"));
    const linkBySlug = new Map(links.map((a) => [a.dataset.tocSlug, a]));
    const targets = links
      .map((a) => document.getElementById(a.dataset.tocSlug ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.classList.remove("is-active"));
          linkBySlug.get(entry.target.id)?.classList.add("is-active");
        }
      },
      // 画面上部 ~80px を基準に、現在地を判定する
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
    );
    targets.forEach((el) => spy.observe(el));
  }
</script>

<style>
  /* 既定（広い画面）= 左側に常時表示するパネル */
  .toc { font-size: 13px; }
  /* 広い画面では小見出しとして表示し、開閉はさせない（pointer-events: none） */
  .toc-summary {
    display: block;
    margin-bottom: 8px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--ai);
    list-style: none;
    pointer-events: none;
  }
  .toc-summary::-webkit-details-marker { display: none; }

  .toc-nav {
    border-left: 2px solid var(--line);
    padding-left: 14px;
  }
  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-item { margin: 2px 0; }
  .toc-item.depth-3 { padding-left: 14px; }

  .toc-item a {
    display: block;
    padding: 3px 6px;
    border-radius: 5px;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .toc-item a:hover { background: var(--paper-sunk); color: var(--ink); text-decoration: none; }

  /* 今読んでいる見出し（スクリプトが付与） */
  .toc-item a.is-active {
    color: var(--ai);
    font-weight: 700;
    background: var(--ai-wash);
  }

  /* 狭い画面（タブレット以下）= 折りたたみ式の見出し付きカード */
  @media (max-width: 1180px) {
    .toc {
      margin: 0 auto 24px;
      max-width: var(--content-max);
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--card);
      overflow: hidden;
    }
    .toc-summary {
      margin-bottom: 0;
      padding: 12px 16px;
      cursor: pointer;
      pointer-events: auto; /* 狭い画面ではタップで開閉する */
      font-size: 14px;
    }
    .toc-summary::after { content: "＋"; float: right; color: var(--ink-faint); }
    .toc[open] .toc-summary::after { content: "−"; }
    .toc-nav { border-left: none; padding: 0 16px 14px; }
  }
</style>
