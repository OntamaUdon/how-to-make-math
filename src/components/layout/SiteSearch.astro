---
/* SiteSearch.astro — サイト内のワード検索。上部バーのボタン＋全画面オーバーレイ。
   ・索引は二段構え。/search-index.json（ページ題・分野・見出し／軽い）がまず届いて即座に検索でき、
     /search-body.json（本文／重い）が届いた時点で本文ヒットを結果に足す。
   ・既存レイアウト（左目次・本文・右広告の3カラム）には一切触らない。追加されるのは
     上部バーのボタン1つと、開いたときだけ出る <dialog> だけ。
   ・見た目はすべて既存のテーマトークン（--paper / --ink / --ai / --shu …）で組むので、
     どの配色テーマに切り替えても勝手についてくる。
   ・結果はスクリプトで組み立てる＝Astro のスコープ属性が付かないため、
     スタイルは is:global にして代わりに .ss- / #ss- で名前空間を切っている。 */
---

<button type="button" id="ss-open" aria-label="サイト内を検索">
  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
       stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
  </svg>
  <span class="ss-open-text">検索</span>
  <kbd class="ss-open-kbd" id="ss-kbd">Ctrl K</kbd>
</button>

<dialog id="ss-dialog" aria-label="サイト内検索">
  <div class="ss-head">
    <svg class="ss-head-icon" viewBox="0 0 24 24" width="17" height="17" fill="none"
         stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
    </svg>
    <input
      id="ss-input"
      type="search"
      placeholder="サイト内をワード検索（例：コンパクト）"
      aria-label="検索語"
      aria-controls="ss-results"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" id="ss-close" aria-label="検索を閉じる">✕</button>
  </div>

  <div class="ss-statusbar">
    <p id="ss-status"></p>
    <button type="button" id="ss-clear" hidden>履歴をすべて消す</button>
  </div>

  <ul id="ss-results" role="listbox" aria-label="検索結果"></ul>

  <div class="ss-foot">
    <span><kbd>↑</kbd> <kbd>↓</kbd> 移動</span>
    <span><kbd>Enter</kbd> 開く</span>
    <span><kbd>Esc</kbd> 閉じる</span>
  </div>
</dialog>

<script>
  interface MetaDoc {
    h: string; // href
    t: string; // ページ題
    s: string; // 分野名
    b: string; // バッジ（解析／代数／幾何／基礎）
    d: string; // 概要
    g: string[]; // 見出し
  }
  /** 索引 1 件。tl/sl/dl/gl は照合用に小文字化したもの（長さは元と同じ＝位置がずれない） */
  interface Doc extends MetaDoc {
    tl: string;
    sl: string;
    dl: string;
    gl: string;
  }
  interface Hit {
    doc: Doc;
    at: number; // searchDocs 内の添字（本文配列と共通）
    score: number;
  }

  const openBtn = document.getElementById("ss-open") as HTMLButtonElement | null;
  const dialog = document.getElementById("ss-dialog") as HTMLDialogElement | null;
  const input = document.getElementById("ss-input") as HTMLInputElement | null;
  const results = document.getElementById("ss-results") as HTMLUListElement | null;
  const status = document.getElementById("ss-status") as HTMLParagraphElement | null;
  const closeBtn = document.getElementById("ss-close") as HTMLButtonElement | null;
  const clearBtn = document.getElementById("ss-clear") as HTMLButtonElement | null;

  if (openBtn && dialog && input && results && status) {
    const RECENT_KEY = "site-search-recent";
    const RECENT_MAX = 5;
    const RESULT_MAX = 40;
    const SNIPPET_BEFORE = 36; // 一致箇所の前に見せる文字数
    const SNIPPET_AFTER = 76; //  〃 後ろ

    let docs: Doc[] | null = null;
    let bodiesRaw: string[] | null = null; // 表示用（元の大小文字のまま）
    let bodies: string[] | null = null; // 照合用（小文字化）
    let started = false;
    let selected = -1;
    let timer = 0;

    // ── 小さな道具 ──────────────────────────────────────────────

    const escapeHtml = (s: string): string =>
      s.replace(/[&<>"]/g, (c) =>
        c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : "&quot;"
      );

    /** 検索語の正規化。全角英数などは NFKC で半角に寄せてから小文字化する。
        照合される側（本文・題名）は小文字化だけ＝文字数が変わらないので、
        一致位置をそのまま抜き出し・ハイライトに使える。 */
    const terms = (query: string): string[] =>
      query
        .normalize("NFKC")
        .toLowerCase()
        .split(/[\s　]+/)
        .filter(Boolean)
        .slice(0, 6);

    function countIn(hay: string, needle: string): number {
      let n = 0;
      let i = hay.indexOf(needle);
      while (i !== -1 && n < 40) {
        n++;
        i = hay.indexOf(needle, i + needle.length);
      }
      return n;
    }

    /** 一致した語を <mark> で包む。text はそのまま、照合は小文字版で行う */
    function highlight(text: string, words: string[]): string {
      const low = text.toLowerCase();
      const spans: Array<[number, number]> = [];
      for (const word of words) {
        let i = low.indexOf(word);
        while (i !== -1) {
          spans.push([i, i + word.length]);
          i = low.indexOf(word, i + word.length);
        }
      }
      if (spans.length === 0) return escapeHtml(text);

      spans.sort((a, b) => a[0] - b[0]);
      let out = "";
      let cursor = 0;
      for (const [from, to] of spans) {
        if (from < cursor) continue; // 語どうしが重なったら先に見つけた方を採る
        out += escapeHtml(text.slice(cursor, from));
        out += `<mark>${escapeHtml(text.slice(from, to))}</mark>`;
        cursor = to;
      }
      return out + escapeHtml(text.slice(cursor));
    }

    // ── 検索本体 ────────────────────────────────────────────────

    function collect(words: string[]): Hit[] {
      const hits: Hit[] = [];
      const list = docs ?? [];

      for (let at = 0; at < list.length; at++) {
        const doc = list[at];
        const body = bodies ? bodies[at] : "";
        let score = 0;
        let all = true;

        for (const word of words) {
          let s = 0;
          if (doc.tl.includes(word)) s += 120; // ページ題に出るのが一番強い
          if (doc.sl.includes(word)) s += 45; // 分野名
          if (doc.gl.includes(word)) s += 35; // 見出し
          if (doc.dl.includes(word)) s += 25; // 概要
          const n = body ? countIn(body, word) : 0;
          if (n > 0) s += 14 + Math.min(n, 8) * 3; // 本文（回数も少し効かせる）
          if (s === 0) {
            all = false; // 1語でも見つからなければ落とす（AND 検索）
            break;
          }
          score += s;
        }
        if (!all) continue;

        if (!/\/\d+$/.test(doc.h)) score += 10; // 分野の地図ページを気持ち優先
        hits.push({ doc, at, score });
      }

      hits.sort((a, b) => b.score - a.score || a.doc.h.localeCompare(b.doc.h));
      return hits.slice(0, RESULT_MAX);
    }

    /** 一致箇所の前後を抜き出す。本文がまだ無い／本文に無い語なら概要文で代える */
    function snippet(hit: Hit, words: string[]): string {
      const raw = bodiesRaw ? bodiesRaw[hit.at] : "";
      const low = bodies ? bodies[hit.at] : "";

      let at = -1;
      if (low) {
        for (const word of words) {
          const i = low.indexOf(word);
          if (i !== -1 && (at === -1 || i < at)) at = i;
        }
      }
      if (at === -1) return highlight(hit.doc.d || hit.doc.g.join(" / "), words);

      const from = Math.max(0, at - SNIPPET_BEFORE);
      const to = Math.min(raw.length, at + SNIPPET_AFTER);
      const text =
        (from > 0 ? "…" : "") + raw.slice(from, to) + (to < raw.length ? "…" : "");
      return highlight(text, words);
    }

    // ── 描画 ────────────────────────────────────────────────────

    function readRecent(): string[] {
      try {
        const saved: unknown = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]");
        if (!Array.isArray(saved)) return [];
        return saved.filter((x): x is string => typeof x === "string").slice(0, RECENT_MAX);
      } catch (e) {
        return [];
      }
    }

    function saveRecent(query: string): void {
      const word = query.trim();
      if (!word) return;
      const next = [word, ...readRecent().filter((x) => x !== word)].slice(0, RECENT_MAX);
      try {
        localStorage.setItem(RECENT_KEY, JSON.stringify(next));
      } catch (e) {
        /* 保存できなくても検索そのものは効く */
      }
    }

    /** 履歴を1件だけ消す */
    function forgetRecent(word: string): void {
      try {
        localStorage.setItem(
          RECENT_KEY,
          JSON.stringify(readRecent().filter((x) => x !== word))
        );
      } catch (e) {
        /* 消せなくても表示は作り直す */
      }
      renderRecent();
    }

    /** 履歴をまとめて消す */
    function forgetAllRecent(): void {
      try {
        localStorage.removeItem(RECENT_KEY);
      } catch (e) {
        /* 同上 */
      }
      renderRecent();
      input!.focus();
    }

    function renderRecent(): void {
      selected = -1;
      const recent = readRecent();
      if (clearBtn) clearBtn.hidden = recent.length === 0;

      if (recent.length === 0) {
        status!.textContent = "調べたい語を入力してください。本文の中まで探します。";
        results!.innerHTML = "";
        return;
      }
      status!.textContent = "最近の検索";
      results!.innerHTML = recent
        .map(
          (word) => `<li class="ss-item ss-item-recent"><button type="button"
            class="ss-link ss-recent" data-recent="${escapeHtml(word)}"><span
            class="ss-recent-mark">↺</span>${escapeHtml(word)}</button><button type="button"
            class="ss-forget" data-forget="${escapeHtml(word)}"
            aria-label="「${escapeHtml(word)}」を履歴から消す" title="履歴から消す">✕</button></li>`
        )
        .join("");
    }

    function render(): void {
      const words = terms(input!.value);

      if (words.length === 0) {
        renderRecent();
        return;
      }
      if (clearBtn) clearBtn.hidden = true; // 「履歴をすべて消す」は履歴表示中だけ出す
      if (!docs) {
        status!.textContent = "索引を読み込み中…";
        results!.innerHTML = "";
        return;
      }

      const hits = collect(words);
      selected = hits.length > 0 ? 0 : -1;
      const loadingBody = bodies ? "" : "（本文を読み込み中…）";

      status!.textContent =
        hits.length === 0
          ? bodies
            ? "見つかりませんでした。"
            : `見出しには見つかりません${loadingBody}`
          : `${hits.length} 件${hits.length >= RESULT_MAX ? "以上" : ""}${loadingBody}`;

      results!.innerHTML = hits
        .map(
          (hit, i) => `<li class="ss-item${i === 0 ? " is-active" : ""}" role="option"
            aria-selected="${i === 0}"><a class="ss-link" href="${escapeHtml(hit.doc.h)}">
            <span class="ss-meta">${
              hit.doc.b ? `<span class="ss-badge">${escapeHtml(hit.doc.b)}</span>` : ""
            }<span>${escapeHtml(hit.doc.s)}</span></span>
            <span class="ss-title">${highlight(hit.doc.t, words)}</span>
            <span class="ss-snip">${snippet(hit, words)}</span></a></li>`
        )
        .join("");
    }

    // ── 索引の読み込み（検索を開いたときに一度だけ） ─────────────

    function loadIndex(): void {
      if (started) return;
      started = true;

      fetch(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/search-index.json`)
        .then((r) => r.json())
        .then((json: { docs: MetaDoc[] }) => {
          docs = json.docs.map((d) => ({
            ...d,
            tl: d.t.toLowerCase(),
            sl: d.s.toLowerCase(),
            dl: d.d.toLowerCase(),
            gl: d.g.join(" ").toLowerCase(),
          }));
          render();
        })
        .catch(() => {
          status!.textContent = "索引を読み込めませんでした。";
        });

      fetch(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/search-body.json`)
        .then((r) => r.json())
        .then((json: { bodies: string[] }) => {
          bodiesRaw = json.bodies;
          bodies = json.bodies.map((b) => b.toLowerCase());
          render();
        })
        .catch(() => {
          /* 本文が読めなくても、見出しまでの検索は動き続ける */
        });
    }

    // ── 開閉 ────────────────────────────────────────────────────

    function lockScroll(on: boolean): void {
      if (on) {
        // スクロールバーが消えるぶんを詰めて、背後のレイアウトがずれないようにする
        const gap = window.innerWidth - document.documentElement.clientWidth;
        document.body.style.overflow = "hidden";
        if (gap > 0) document.body.style.paddingRight = `${gap}px`;
      } else {
        document.body.style.overflow = "";
        document.body.style.paddingRight = "";
      }
    }

    function openSearch(): void {
      loadIndex();
      if (!dialog!.open) dialog!.showModal();
      lockScroll(true);
      render();
      input!.focus();
      input!.select();
    }

    /* 閉じる処理は必ずここを通す。close イベント任せにすると、
       それが飛ばない状況で背後のスクロール固定が解けないまま残ってしまう。 */
    function closeSearch(): void {
      if (dialog!.open) dialog!.close();
      lockScroll(false);
    }

    openBtn.addEventListener("click", openSearch);
    closeBtn?.addEventListener("click", closeSearch);
    dialog.addEventListener("close", () => lockScroll(false)); // 念のための保険
    dialog.addEventListener("cancel", () => lockScroll(false));

    // 背景（::backdrop）のクリックで閉じる
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeSearch();
    });

    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 90);
    });

    // ── キーボード ──────────────────────────────────────────────

    function move(delta: number): void {
      const items = Array.from(results!.querySelectorAll<HTMLLIElement>(".ss-item"));
      if (items.length === 0) return;
      selected = (selected + delta + items.length) % items.length;
      items.forEach((li, i) => {
        li.classList.toggle("is-active", i === selected);
        li.setAttribute("aria-selected", String(i === selected));
      });
      items[selected].scrollIntoView({ block: "nearest" });
    }

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        // 既定の閉じる動作に任せず自分で閉じる（上の closeSearch を必ず通すため）
        event.preventDefault();
        closeSearch();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        move(1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        move(-1);
      } else if (event.key === "Enter") {
        const items = Array.from(results.querySelectorAll<HTMLLIElement>(".ss-item"));
        const target = items[selected >= 0 ? selected : 0];
        const link = target?.querySelector<HTMLElement>(".ss-link");
        if (link) {
          event.preventDefault();
          link.click();
        }
      }
    });

    clearBtn?.addEventListener("click", forgetAllRecent);

    // 結果クリック：検索語を覚えてから移動する（「最近の検索」は入力欄に入れ直す）
    results.addEventListener("click", (event) => {
      const forget = (event.target as HTMLElement).closest<HTMLElement>("[data-forget]");
      if (forget) {
        forgetRecent(forget.dataset.forget ?? "");
        input.focus();
        return;
      }

      const recent = (event.target as HTMLElement).closest<HTMLElement>("[data-recent]");
      if (recent) {
        input.value = recent.dataset.recent ?? "";
        input.focus();
        render();
        return;
      }
      if ((event.target as HTMLElement).closest(".ss-link")) {
        saveRecent(input.value);
        closeSearch(); // 今いるページへのリンクを押したときも閉じる
      }
    });

    // サイトのどこからでも Ctrl+K（Mac は ⌘K）と「/」で開く
    const isMac = /mac|iphone|ipad/i.test(navigator.userAgent);
    const kbd = document.getElementById("ss-kbd");
    if (kbd && isMac) kbd.textContent = "⌘K";

    document.addEventListener("keydown", (event) => {
      if (dialog.open) return;

      const key = event.key.toLowerCase();
      if (key === "k" && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        openSearch();
        return;
      }

      // 「/」は、文字を打ち込んでいる最中には反応させない
      const active = document.activeElement as HTMLElement | null;
      const typing =
        !!active &&
        (active.isContentEditable ||
          ["INPUT", "TEXTAREA", "SELECT"].includes(active.tagName));
      if (event.key === "/" && !typing && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        openSearch();
      }
    });
  }
</script>

<style is:global>
  /* ── 上部バーの検索ボタン（テーマ切替の左隣。見た目は入力欄ふう） ── */
  #ss-open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    min-width: 200px;
    padding: 5px 9px 5px 11px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-faint);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  #ss-open:hover {
    border-color: var(--ai);
    color: var(--ink);
  }
  #ss-open:focus-visible {
    outline: 2px solid var(--ai);
    outline-offset: 1px;
  }
  .ss-open-text {
    flex: 1;
    text-align: left;
  }

  /* ── オーバーレイ本体 ── */
  #ss-dialog {
    display: none; /* [open] のときだけ flex にする（dialog の既定を壊さないため） */
    flex-direction: column;
    width: min(720px, calc(100vw - 28px));
    max-width: none;
    max-height: min(74vh, 700px);
    margin: 9vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.6;
    box-shadow: 0 26px 70px -26px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  #ss-dialog[open] {
    display: flex;
  }
  #ss-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .ss-head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    padding: 11px 13px;
    border-bottom: 1px solid var(--line);
    background: var(--card);
  }
  .ss-head-icon {
    flex: none;
    color: var(--ai);
  }
  #ss-input {
    flex: 1;
    min-width: 0;
    padding: 4px 0;
    font-family: var(--sans);
    font-size: 16px; /* iOS で拡大されないよう 16px は下回らせない */
    color: var(--ink);
    background: transparent;
    border: 0;
    outline: none;
  }
  #ss-input::placeholder {
    color: var(--ink-faint);
  }
  #ss-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  #ss-close {
    flex: none;
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--ink-faint);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }
  #ss-close:hover {
    border-color: var(--ai);
    color: var(--ai);
  }

  .ss-statusbar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
    padding: 8px 16px;
    border-bottom: 1px solid var(--line);
  }
  #ss-status {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  #ss-clear {
    flex: none;
    padding: 3px 9px;
    font-family: var(--sans);
    font-size: 11px;
    color: var(--ink-faint);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 6px;
    cursor: pointer;
  }
  #ss-clear[hidden] {
    display: none;
  }
  #ss-clear:hover {
    color: var(--shu);
    border-color: var(--shu);
  }

  #ss-results {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
    margin: 0;
    padding: 6px;
  }
  .ss-item {
    margin: 0;
  }
  .ss-link {
    display: block;
    width: 100%;
    padding: 9px 12px;
    font: inherit;
    text-align: left;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
  }
  .ss-link:hover,
  .ss-item.is-active > .ss-link {
    background: var(--ai-wash);
    color: inherit;
    text-decoration: none;
  }
  .ss-meta {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--ink-faint);
  }
  .ss-badge {
    font-family: var(--latin);
    font-size: 10.5px;
    line-height: 1.7;
    background: var(--ai);
    color: #fff;
    border-radius: 5px;
    padding: 0 6px;
  }
  .ss-title {
    display: block;
    margin: 2px 0 1px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }
