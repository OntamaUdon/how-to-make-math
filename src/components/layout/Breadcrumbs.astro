---
/* Breadcrumbs.astro — 現在地（ホーム → 章 → ページ）。
   findLocation() が返す section / page をそのまま受け取る。 */
import type { NavSection, NavLink } from "../../config/navigation";
import { withBase } from "../../config/base";

interface Props {
  section?: NavSection;
  page?: NavLink;
}
const { section, page } = Astro.props;
---
<nav class="breadcrumbs" aria-label="現在地">
  <a href={withBase("/")}>ホーム</a>
  {section && (
    <Fragment>
      <span class="sep">›</span>
      {section.href
        ? <a href={withBase(section.href)}>{section.title}</a>
        : <span>{section.title}</span>}
    </Fragment>
  )}
  {page && (
    <Fragment>
      <span class="sep">›</span>
      <span aria-current="page">{page.title}</span>
    </Fragment>
  )}
</nav>

<style>
  .breadcrumbs {
    max-width: var(--content-max);
    margin: 0 auto 22px;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .breadcrumbs .sep { margin: 0 7px; }
</style>
