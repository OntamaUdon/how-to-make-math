---
/* SiteNav.astro — ページ下部に置く「サイト全体の目次」。
   分野名だけを並べる（章タイトルは載せない）。章までたどるには、
   各分野の地図ページか、上部バーの検索を使う。
   分野の一覧は Sidebar と同じ siteNav から作るので、片方を直せば両方そろう。
   ただし「隠し部」（navigation.ts で hidden: true）はここに載せない。 */
import { visibleNav, isCurrent } from "../../config/navigation";

const pathname = Astro.url.pathname;

/** その分野のページ（地図でも各章でも）を今開いているか */
const inSection = (href?: string): boolean =>
  !!href && (isCurrent(href, pathname) || pathname.startsWith(`${href}/`));
---

<nav class="sitemap" aria-label="サイト全体の目次">
  <p class="sitemap-head">サイト全体の目次</p>

  <div class="sitemap-grid">
    {visibleNav.map((section) =>
      section.href ? (
        <a
          href={section.href}
          class:list={["sitemap-item", { active: inSection(section.href) }]}
          aria-current={inSection(section.href) ? "true" : undefined}
        >
          {section.badge && <span class="badge">{section.badge}</span>}
          <span class="sitemap-name">{section.title}</span>
        </a>
      ) : (
        <span class="sitemap-item is-plain">
          {section.badge && <span class="badge">{section.badge}</span>}
          <span class="sitemap-name">{section.title}</span>
        </span>
      )
    )}
  </div>
</nav>

<style>
  .sitemap { max-width: var(--layout-max); margin: 0 auto; padding: 8px 24px; }
  .sitemap-head {
    font-family: var(--serif);
    font-weight: 700;
    color: var(--ai);
    font-size: 14px;
    letter-spacing: 0.08em;
    margin: 0 0 18px;
  }

  /* 分野名を横並びに。画面幅に応じて自動で列数が変わる */
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px 14px;
  }

  .sitemap-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-family: var(--serif);
    font-size: 14.5px;
    color: var(--ink);
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  a.sitemap-item:hover {
    border-color: var(--line);
    background: var(--card);
    color: var(--ai);
    text-decoration: none;
  }
  a.sitemap-item.active {
    border-color: var(--ai);
    background: var(--ai-wash);
    color: var(--ai);
    font-weight: 700;
  }
  .sitemap-item.is-plain { color: var(--ink-soft); }

  .sitemap-name { min-width: 0; }

  .badge {
    flex: none;
    font-family: var(--latin);
    font-size: 11px;
    background: var(--ai);
    color: #fff;
    border-radius: 5px;
    padding: 1px 7px;
  }
</style>
