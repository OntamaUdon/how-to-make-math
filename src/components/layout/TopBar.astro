---
/* TopBar.astro — 上部の固定バー（サイト名 + サイト内検索 + 配色テーマ切替）。
   テーマ切替に必要なもの（メニュー・反映スクリプト・見た目）をここに集約する。
   切替は <head> の #site-theme-css の href を差し替え、localStorage に記憶する。
   検索は SiteSearch.astro に閉じている（ボタンと、開いたときだけ出るオーバーレイ）。 */
import { themes, defaultTheme, themeStorageKey } from "../../config/themes";
import SiteSearch from "./SiteSearch.astro";
import { withBase } from "../../config/base";

const lightThemes = themes.filter((t) => t.group === "light");
const darkThemes = themes.filter((t) => t.group === "dark");
const funThemes = themes.filter((t) => t.group === "fun");
---
<header class="topbar">
  <a href={withBase("/")} class="brand">
    <span class="brand-mark">⟐</span>
    <span class="brand-text">
      <span class="brand-name">数学の作り方</span>
      <span class="brand-sub">How to make Mathematics</span>
    </span>
  </a>

  <!-- 制作ページへの入口。ローカル（npm run dev）でだけ出る＝本番の HTML には含まれない -->
  {import.meta.env.DEV && <a href="/studio" class="studio-link">工房</a>}

  <!-- サイト内のワード検索（ボタンだけを置き、押すとオーバーレイが開く） -->
  <SiteSearch />

  <!-- 配色テーマの切替（選ぶと即反映され、次回も記憶される） -->
  <div class="theme-switch">
    <label class="theme-switch-label" for="theme-select">テーマ</label>
    <select id="theme-select" class="theme-switch-select" aria-label="配色テーマを選ぶ">
      <optgroup label="ライト">
        {lightThemes.map((t) => <option value={t.id}>{t.label}</option>)}
      </optgroup>
      <optgroup label="ダーク">
        {darkThemes.map((t) => <option value={t.id}>{t.label}</option>)}
      </optgroup>
      <optgroup label="あえてダサい">
        {funThemes.map((t) => <option value={t.id}>{t.label}</option>)}
      </optgroup>
    </select>
  </div>
</header>

<script>
  import { themeStorageKey, defaultTheme } from "../../config/themes";

  const select = document.getElementById("theme-select") as HTMLSelectElement | null;
  const link = document.getElementById("site-theme-css") as HTMLLinkElement | null;

  if (select && link) {
    // 現在のテーマをメニューに反映
    select.value = localStorage.getItem(themeStorageKey) ?? defaultTheme;

    select.addEventListener("change", () => {
      const id = select.value;
      link.href = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/themes/theme-${id}.css`;
      try { localStorage.setItem(themeStorageKey, id); } catch (e) { /* 保存できなくても切替は効く */ }
    });
  }
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--topbar-h);
    display: flex;
    align-items: center;
    padding: 0 20px;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: center; gap: 11px; color: var(--ink); }
  .brand:hover { text-decoration: none; }
  .brand-mark { font-size: 26px; color: var(--shu); line-height: 1; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name {
    font-family: var(--latin);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--ai);
  }
  .brand-sub { font-size: 10.5px; letter-spacing: 0.14em; color: var(--ink-faint); }

  /* 制作ページへの入口（ローカルのみ）。右寄せの起点をこちらに移す */
  .studio-link {
    margin-left: auto;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 4px 10px;
  }
  .studio-link:hover { color: var(--ai); border-color: var(--ai); text-decoration: none; }
  .studio-link + :global(#ss-open) { margin-left: 10px; }

  /* 右寄せは検索ボタン側（#ss-open の margin-left: auto）が担当する */
  .theme-switch { display: flex; align-items: center; gap: 8px; margin-left: 12px; }
  .theme-switch-label { font-size: 11px; letter-spacing: 0.12em; color: var(--ink-faint); }
  .theme-switch-select {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 5px 10px;
    cursor: pointer;
  }
  .theme-switch-select:hover { border-color: var(--ai); }
  .theme-switch-select:focus-visible { outline: 2px solid var(--ai); outline-offset: 1px; }
  @media (max-width: 560px) {
    .theme-switch-label { display: none; } /* 狭い画面はラベルを省く */
  }

  /* 検索ボタンが入ったぶん、狭い画面ではバーの中身が押し合って
     サイト名が2行に折れてしまう（バーの高さ 60px をはみ出す）。
     そこで欧文サブタイトルを畳み、テーマ選択の幅を詰めて一段のまま保つ。
     広い画面の見た目はこれまでどおり。 */
  @media (max-width: 620px) {
    .brand-sub { display: none; }
    .brand-name { white-space: nowrap; }
    .theme-switch-select { max-width: 108px; padding: 5px 7px; }
  }
</style>
