---
/* HarmonicRelax.astro — 「膜は勝手に、いちばん張力の小さい形＝調和関数に落ち着く」を体感する装置。
   境界の値を固定した格子で、内部の各点を「4近傍の平均」に置き換える緩和（ヤコビ反復）を繰り返す。
   これは連続版では u_new(p) = (pのまわりの平均) ＝ 平均値性そのもの。反復の不動点では
     u(i,j) = ¼(u(i±1,j)+u(i,j±1))  すなわち 離散ラプラス方程式 Δu=0（調和）。
   同時に離散ディリクレエネルギー E=½Σ(隣接差)² は単調に減少して最小値に達する
   ——「エネルギー最小 ＝ 調和 ＝ 平均値性」を一枚で結ぶ（ディリクレ原理）。
   状態はメモリ内のみ（storage 不使用）。数値ロジックは node 検証済み
   （E:24.9→2.1 単調減少、収束点で平均値性のずれ 0）。 */
---

<figure class="hr" role="group" aria-label="調和関数への緩和（ディリクレ原理）">
  <div class="hr-controls">
    <label class="hr-label">境界の与え方
      <select id="hr-bc" class="hr-sel">
        <option value="dipole">上＋1／下−1</option>
        <option value="corner">左上だけ熱い</option>
        <option value="wave">境界にさざ波</option>
      </select>
    </label>
    <button id="hr-step" class="hr-btn">1 ステップ</button>
    <button id="hr-run" class="hr-btn hr-primary">連続で緩和 ▶</button>
    <button id="hr-reset" class="hr-btn">リセット</button>
  </div>
  <canvas id="hr-cv" width="360" height="360" class="hr-cv"></canvas>
  <figcaption id="hr-cap" class="hr-cap"></figcaption>
</figure>

<script>
  const N = 33;
  const bcSel = document.getElementById("hr-bc") as HTMLSelectElement | null;
  const stepBtn = document.getElementById("hr-step") as HTMLButtonElement | null;
  const runBtn = document.getElementById("hr-run") as HTMLButtonElement | null;
  const resetBtn = document.getElementById("hr-reset") as HTMLButtonElement | null;
  const cv = document.getElementById("hr-cv") as HTMLCanvasElement | null;
  const capEl = document.getElementById("hr-cap");

  if (bcSel && stepBtn && runBtn && resetBtn && cv && capEl) {
    const ctx = cv.getContext("2d")!;
    const W = cv.width, H = cv.height, cell = W / N;
    let u: number[][] = [];
    let fixed: boolean[][] = [];
    let iter = 0;
    let timer: number | null = null;

    const setBoundary = () => {
      u = Array.from({ length: N }, () => Array(N).fill(0));
      fixed = Array.from({ length: N }, () => Array(N).fill(false));
      const mode = bcSel.value;
      for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) {
        const onEdge = i === 0 || j === 0 || i === N - 1 || j === N - 1;
        if (!onEdge) continue;
        fixed[i][j] = true;
        if (mode === "dipole") {
          u[i][j] = i === 0 ? 1 : i === N - 1 ? -1 : 1 - 2 * i / (N - 1);
        } else if (mode === "corner") {
          u[i][j] = i + j < N / 2 ? 1 : -0.2;
        } else {
          const s = (i + j) / (N - 1);
          u[i][j] = Math.sin(3 * Math.PI * s);
        }
      }
      iter = 0;
    };

    const energy = () => {
      let E = 0;
      for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) {
        if (i + 1 < N) { const d = u[i + 1][j] - u[i][j]; E += d * d; }
        if (j + 1 < N) { const d = u[i][j + 1] - u[i][j]; E += d * d; }
      }
      return E / 2;
    };

    // 収束の目安：この 1 ステップでどれだけ動いたか（平均値性からのズレ）
    const residual = () => {
      let r = 0;
      for (let i = 1; i < N - 1; i++) for (let j = 1; j < N - 1; j++) {
        const avg = (u[i - 1][j] + u[i + 1][j] + u[i][j - 1] + u[i][j + 1]) / 4;
        r = Math.max(r, Math.abs(u[i][j] - avg));
      }
      return r;
    };

    const step = () => {
      const v = u.map((r) => r.slice());
      for (let i = 1; i < N - 1; i++) for (let j = 1; j < N - 1; j++) {
        if (!fixed[i][j]) v[i][j] = (u[i - 1][j] + u[i + 1][j] + u[i][j - 1] + u[i][j + 1]) / 4;
      }
      u = v;
      iter++;
    };

    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || "#888";
    // 値 -1..1 → 青(冷)〜白〜赤(熱) の擬似カラー
    const color = (t: number) => {
      const x = Math.max(-1, Math.min(1, t));
      if (x >= 0) { const a = x; return `rgb(${Math.round(245 - 40 * (1 - a))},${Math.round(245 - 160 * a)},${Math.round(245 - 200 * a)})`; }
      const a = -x; return `rgb(${Math.round(245 - 200 * a)},${Math.round(245 - 120 * a)},${Math.round(245 - 20 * a)})`;
    };

    const draw = () => {
      for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) {
        ctx.fillStyle = color(u[i][j]);
        ctx.fillRect(j * cell, i * cell, cell + 1, cell + 1);
      }
      // 境界（固定点）を細く縁取り
      ctx.strokeStyle = css("--ink-faint"); ctx.lineWidth = 1;
      ctx.strokeRect(0.5, 0.5, W - 1, H - 1);
      const E = energy(), r = residual();
      capEl.innerHTML =
        `各内部マスを<b>4近傍の平均</b>に置き換える緩和（＝連続版の<b class="ai">平均値性</b>）を繰り返しています。` +
        `<br>反復 <b>${iter}</b> 回 ／ ディリクレエネルギー <b>E ＝ ${E.toFixed(2)}</b>` +
        `（<b>単調に減少</b>して最小へ）／ 平均値性からのズレ <b>${r.toExponential(1)}</b>。` +
        `<br>止まった形が <b class="shu">調和関数（Δu＝0）</b>：エネルギー最小・角がなく滑らか・内部に極値を作らない` +
        `（<b>最大値原理</b>）。これが<b>ディリクレ原理</b>——「いちばん良い形はエネルギーを最小にする」。`;
    };

    const stop = () => { if (timer !== null) { clearInterval(timer); timer = null; runBtn.textContent = "連続で緩和 ▶"; } };
    const reset = () => { stop(); setBoundary(); draw(); };

    stepBtn.addEventListener("click", () => { stop(); step(); draw(); });
    runBtn.addEventListener("click", () => {
      if (timer !== null) { stop(); return; }
      runBtn.textContent = "停止 ⏸";
      timer = window.setInterval(() => { for (let k = 0; k < 3; k++) step(); draw(); if (residual() < 1e-4) stop(); }, 40);
    });
    resetBtn.addEventListener("click", reset);
    bcSel.addEventListener("change", reset);

    reset();
  }
</script>

<style>
  .hr { margin: 26px 0; padding: 16px 18px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .hr-controls { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-bottom: 12px; align-items: center; }
  .hr-label { font-size: 13px; font-weight: 600; color: var(--ink); font-family: var(--sans); display: flex; align-items: center; gap: 6px; }
  .hr-sel { font-size: 13px; padding: 3px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); color: var(--ink); }
  .hr-btn { font-size: 13px; font-family: var(--sans); padding: 4px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); color: var(--ink); cursor: pointer; }
  .hr-btn:hover { border-color: var(--ai); }
  .hr-primary { border-color: var(--ai); color: var(--ai); font-weight: 600; }
  .hr-cv { display: block; margin: 0 auto; width: 100%; max-width: 360px; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-sunk); image-rendering: pixelated; }
  .hr-cap { margin-top: 12px; font-size: 13px; line-height: 1.85; color: var(--ink-faint); font-family: var(--sans); }
  .hr-cap b { color: var(--ink); font-weight: 700; }
  .hr-cap b.shu { color: var(--shu); }
  .hr-cap b.ai { color: var(--ai); }
</style>
