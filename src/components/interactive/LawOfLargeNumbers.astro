---
/* LawOfLargeNumbers.astro — 大数の法則を体感する装置。
   独立同分布（サイコロ／コイン）を次々に引き、その「これまでの平均」= 標本平均 S_n/n を
   n の増加とともに折れ線で描く。何本もの軌道を薄く重ねると、みな真の平均 μ へ吸い込まれていく。
   同時に、チェビシェフが保証する揺らぎの帯 μ ± 2σ/√n（√n で縮む漏斗）を重ねて、
   「なぜ収束が速くなるか」を見せる。サンプル数 N はスライダー、別の乱数列は「引き直す」で。
   乱数は seed 付き（mulberry32）。状態はメモリ内のみ（storage 不使用）。 */
---

<figure class="ll" role="group" aria-label="大数の法則：標本平均の収束">
  <div class="ll-controls">
    <div class="ll-modeswitch" role="tablist" aria-label="引くもの">
      <button id="ll-die" type="button" class="ll-mode is-on" role="tab">サイコロ（μ=3.5）</button>
      <button id="ll-coin" type="button" class="ll-mode" role="tab">コイン（μ=0.5）</button>
    </div>
    <label class="ll-label">試行数 N ＝ <span id="ll-nval">200</span>
      <input id="ll-n" type="range" min="20" max="500" value="200" step="10" class="ll-range" />
    </label>
    <button id="ll-reseed" type="button" class="ll-btn">別の乱数で引き直す</button>
  </div>
  <canvas id="ll-cv" width="380" height="240" class="ll-cv"></canvas>
  <figcaption id="ll-cap" class="ll-cap"></figcaption>
</figure>

<script>
  type Mode = "die" | "coin";

  const dists: Record<Mode, {
    draw: (r: () => number) => number;
    mu: number; sd: number; lo: number; hi: number; name: string;
  }> = {
    // サイコロ：μ=3.5, σ²=35/12
    die: { draw: (r) => 1 + Math.floor(r() * 6), mu: 3.5, sd: Math.sqrt(35 / 12), lo: 1, hi: 6, name: "サイコロ" },
    // コイン：μ=0.5, σ=0.5
    coin: { draw: (r) => (r() < 0.5 ? 1 : 0), mu: 0.5, sd: 0.5, lo: 0, hi: 1, name: "コイン" },
  };

  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const cv = document.getElementById("ll-cv") as HTMLCanvasElement | null;
  const capEl = document.getElementById("ll-cap");
  const nEl = document.getElementById("ll-n") as HTMLInputElement | null;
  const nVal = document.getElementById("ll-nval");
  const btnDie = document.getElementById("ll-die");
  const btnCoin = document.getElementById("ll-coin");
  const btnRe = document.getElementById("ll-reseed");

  if (cv && capEl && nEl && nVal && btnDie && btnCoin && btnRe) {
    const ctx = cv.getContext("2d")!;
    const W = cv.width, H = cv.height;
    const padL = 30, padR = 10, padT = 12, padB = 22;
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || "#888";
    let mode: Mode = "die";
    let baseSeed = 20260711;
    const PATHS = 6;                        // 薄く重ねる軌道の本数

    const render = () => {
      ctx.clearRect(0, 0, W, H);
      const N = Number(nEl.value);
      nVal.textContent = String(N);
      const { draw, mu, sd, lo, hi, name } = dists[mode];
      // y は分布の値域より少し広く
      const yLo = lo - (hi - lo) * 0.15, yHi = hi + (hi - lo) * 0.15;
      const px = (n: number) => padL + (n - 1) / (N - 1) * (W - padL - padR);
      const py = (y: number) => (H - padB) - (y - yLo) / (yHi - yLo) * (H - padB - padT);

      // チェビシェフの漏斗 μ ± 2σ/√n（√n で縮む）
      ctx.fillStyle = css("--shu"); ctx.save(); ctx.globalAlpha = 0.10;
      ctx.beginPath();
      for (let n = 1; n <= N; n++) ctx.lineTo(px(n), py(mu + 2 * sd / Math.sqrt(n)));
      for (let n = N; n >= 1; n--) ctx.lineTo(px(n), py(mu - 2 * sd / Math.sqrt(n)));
      ctx.closePath(); ctx.fill(); ctx.restore();

      // 真の平均 μ の水平線
      ctx.strokeStyle = css("--shu"); ctx.lineWidth = 1.6; ctx.setLineDash([6, 4]);
      ctx.beginPath(); ctx.moveTo(px(1), py(mu)); ctx.lineTo(px(N), py(mu)); ctx.stroke();
      ctx.setLineDash([]);

      // 軸
      ctx.strokeStyle = css("--line"); ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(px(1), H - padB); ctx.lineTo(px(N), H - padB);
      ctx.moveTo(px(1), padT); ctx.lineTo(px(1), H - padB);
      ctx.stroke();

      // 何本かの軌道（薄い藍）＋最後の1本は濃く
      let lastMean = mu;
      for (let p = 0; p < PATHS; p++) {
        const rng = mulberry32(baseSeed + p * 7919);
        let sum = 0;
        const isMain = p === PATHS - 1;
        ctx.strokeStyle = css("--ai");
        ctx.globalAlpha = isMain ? 1 : 0.22;
        ctx.lineWidth = isMain ? 2 : 1;
        ctx.beginPath();
        for (let n = 1; n <= N; n++) {
          sum += draw(rng);
          const m = sum / n;
          n === 1 ? ctx.moveTo(px(n), py(m)) : ctx.lineTo(px(n), py(m));
          if (isMain) lastMean = m;
        }
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      capEl.innerHTML =
        `<b>${name}</b>を次々に引いて、<b class="ai">「ここまでの平均」S<sub>n</sub>/n（藍）</b>を描画。` +
        `最初は大きく暴れても、n が増えると <b class="shu">真の平均 μ=${mu}（朱の破線）</b>へ吸い込まれる。<br>` +
        `<b class="shu">朱の帯 μ ± 2σ/√n</b> はチェビシェフが保証する揺らぎの幅。<b>√n の速さで漏斗が狭まる</b>ので、` +
        `どの軌道も外へ出にくくなり収束する。<br>` +
        `<span class="ll-dim">N=${N} での主軌道（濃い藍）の平均 ≈ ${lastMean.toFixed(3)}（真値 ${mu}）。「引き直す」で別の乱数列でも同じ漏斗に収まるのを確認。</span>`;
    };

    const setMode = (m: Mode) => {
      mode = m;
      btnDie.classList.toggle("is-on", m === "die");
      btnCoin.classList.toggle("is-on", m === "coin");
      render();
    };
    btnDie.addEventListener("click", () => setMode("die"));
    btnCoin.addEventListener("click", () => setMode("coin"));
    btnRe.addEventListener("click", () => { baseSeed = (baseSeed * 1103515245 + 12345) >>> 0; render(); });
    nEl.addEventListener("input", render);
    render();
  }
</script>

<style>
  .ll { margin: 26px 0; padding: 16px 18px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .ll-controls { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
  .ll-modeswitch { display: inline-flex; gap: 4px; padding: 3px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper-sunk); width: fit-content; }
  .ll-mode { appearance: none; border: none; background: transparent; color: var(--ink-faint); font-family: var(--sans); font-size: 12.5px; font-weight: 600; padding: 5px 12px; border-radius: 7px; cursor: pointer; }
  .ll-mode.is-on { background: var(--card); color: var(--ai); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .ll-label { font-size: 13px; font-weight: 600; color: var(--ink); font-family: var(--sans); display: flex; align-items: center; gap: 8px; }
  .ll-range { flex: 1; max-width: 220px; accent-color: var(--ai); }
  .ll-btn { appearance: none; border: 1px solid var(--line); background: var(--paper-sunk); color: var(--ink); font-family: var(--sans); font-size: 12.5px; font-weight: 600; padding: 6px 14px; border-radius: 8px; cursor: pointer; width: fit-content; }
  .ll-btn:hover { border-color: var(--ai); color: var(--ai); }
  .ll-cv { display: block; margin: 0 auto; width: 100%; max-width: 380px; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-sunk); }
  .ll-cap { margin-top: 12px; font-size: 13px; line-height: 1.85; color: var(--ink-faint); font-family: var(--sans); }
  .ll-cap b { color: var(--ink); font-weight: 700; }
  .ll-cap b.shu { color: var(--shu); }
  .ll-cap b.ai { color: var(--ai); }
  .ll-cap .ll-dim { color: var(--ink-faint); }
</style>
