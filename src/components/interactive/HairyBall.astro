---
/* HairyBall.astro — 毛玉の定理（球面の接ベクトル場は必ず零点をもつ）の体験装置。
   球面 S² 上の接ベクトル場を正射影で描く。スライダーで球を回して眺められる。
   ・どの向きに「毛を撫でつけても」極（零点）が消えない＝毛玉の定理。
   ・零点の指数の和は χ(S²)=2（ポアンカレ–ホップの定理、位相幾何のオイラー標数と一致）。
   状態はメモリ内のみ（storage 不使用）。 */
---

<figure class="hb" role="group" aria-label="毛玉の定理">
  <div class="hb-controls">
    <label class="hb-label">場
      <select id="hb-field" class="hb-sel">
        <option value="flow">南北の流れ（湧き出し＋吸い込み）</option>
        <option value="spiral">渦巻き</option>
      </select>
    </label>
    <label class="hb-label">回転 <input id="hb-rot" type="range" min="0" max="6.28" step="0.03" value="0.6" /></label>
  </div>
  <canvas id="hb-cv" width="300" height="300" class="hb-cv"></canvas>
  <figcaption id="hb-cap" class="hb-cap"></figcaption>
</figure>

<script>
  const sel = document.getElementById("hb-field") as HTMLSelectElement | null;
  const rotIn = document.getElementById("hb-rot") as HTMLInputElement | null;
  const cv = document.getElementById("hb-cv") as HTMLCanvasElement | null;
  const capEl = document.getElementById("hb-cap");

  if (sel && rotIn && cv && capEl) {
    const ctx = cv.getContext("2d")!;
    const W = cv.width, H = cv.height, cxp = W / 2, cyp = H / 2, Rr = 128;
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || "#888";
    const sx = (X: number) => cxp + X * Rr, sy = (Y: number) => cyp - Y * Rr;

    const render = () => {
      const rot = parseFloat(rotIn.value);
      const spiral = sel.value === "spiral";
      ctx.clearRect(0, 0, W, H);
      // 球の輪郭
      ctx.strokeStyle = css("--ai"); ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(cxp, cyp, Rr, 0, 2 * Math.PI); ctx.stroke();

      // 接ベクトル場（正射影、視線は y 軸。前面 depth>0 のみ描く）
      const nTh = 12, nPh = 24;
      for (let i = 1; i < nTh; i++) {
        const th = Math.PI * i / nTh;
        for (let j = 0; j < nPh; j++) {
          const ph = 2 * Math.PI * j / nPh + rot;
          const depth = Math.sin(th) * Math.sin(ph);
          if (depth <= 0.02) continue;                 // 前面のみ
          const X = Math.sin(th) * Math.cos(ph), Z = Math.cos(th);
          // 接ベクトル：flow は ∂/∂θ（南向き）、spiral は ∂/∂θ + ∂/∂φ の混合
          let tX = Math.cos(th) * Math.cos(ph), tZ = -Math.sin(th);        // ∂/∂θ の (x,z)
          if (spiral) tX = Math.cos(th) * Math.cos(ph) - Math.sin(ph);     // ∂/∂θ に回転成分を加える
          const m = Math.hypot(tX, tZ) || 1; tX /= m; tZ /= m;
          const x0 = sx(X), y0 = sy(Z), L = 9;
          ctx.strokeStyle = css("--ink-faint"); ctx.globalAlpha = 0.35 + 0.5 * depth; ctx.lineWidth = 1.3;
          ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x0 + tX * L, y0 - tZ * L); ctx.stroke();
          ctx.globalAlpha = 1; ctx.fillStyle = css("--ink-faint"); ctx.beginPath(); ctx.arc(x0 + tX * L, y0 - tZ * L, 1.2, 0, 2 * Math.PI); ctx.fill();
        }
      }
      // 零点（両極）
      ctx.fillStyle = css("--shu");
      for (const [Z, name] of [[1, "湧き出し"], [-1, "吸い込み"]] as [number, string][]) {
        ctx.beginPath(); ctx.arc(sx(0), sy(Z), 6, 0, 2 * Math.PI); ctx.fill();
        ctx.strokeStyle = css("--shu"); ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(sx(0), sy(Z), 11, 0, 2 * Math.PI); ctx.stroke();
      }

      capEl.innerHTML =
        `球面 S² の接ベクトル場。どう「毛を撫でつけても」上下の<b>2 つの極（零点）</b>が消えない——<b>毛玉の定理</b>。` +
        ` 零点の指数の和 = 1 + 1 = <b>2 = χ(S²)</b>（<b>ポアンカレ–ホップの定理</b>）。` +
        " 位相幾何のオイラー標数が、なめらかなベクトル場の零点を支配する。トーラス（χ=0）なら零点なしの場が作れる。";
    };
    sel.addEventListener("change", render); rotIn.addEventListener("input", render);
    render();
  }
</script>

<style>
  .hb { margin: 26px 0; padding: 16px 18px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .hb-controls { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-bottom: 12px; align-items: center; }
  .hb-label { font-size: 13px; font-weight: 600; color: var(--ink); font-family: var(--sans); display: flex; align-items: center; gap: 6px; }
  .hb-label input[type=range] { width: 120px; accent-color: var(--shu); }
  .hb-sel { font-family: var(--sans); font-size: 13px; padding: 4px 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper-sunk); color: var(--ink); }
  .hb-cv { display: block; margin: 0 auto; width: 100%; max-width: 300px; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-sunk); }
  .hb-cap { margin-top: 12px; font-size: 13px; line-height: 1.8; color: var(--ink-faint); font-family: var(--sans); }
  .hb-cap b { color: var(--ink); font-weight: 700; }
</style>
