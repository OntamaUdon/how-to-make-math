---
/* SlopeField.astro — 方向場（傾き場）と解曲線の体験装置。
   一階微分方程式 y'=f(x,y) を選ぶと、各点で傾き f(x,y) の短い線分（方向場）を描く。
   キャンバスをクリックすると、その点を通る解曲線を RK4 で前後に積分して描く。
   「微分方程式＝各点で進む向きを指定する場」「解＝その向きに沿う曲線」を体感する。
   状態はメモリ内のみ（storage 不使用）。 */
---

<figure class="sf" role="group" aria-label="方向場と解曲線">
  <div class="sf-controls">
    <label class="sf-label">y′ =
      <select id="sf-eq" class="sf-sel">
        <option value="y">y（指数的増大）</option>
        <option value="xmy">x − y</option>
        <option value="logi">y(1 − y)（ロジスティック）</option>
        <option value="circ">−x / y（同心円）</option>
        <option value="xy">x·y</option>
        <option value="sinx">sin(x) − y</option>
      </select>
    </label>
    <button id="sf-clear" type="button" class="sf-btn">解曲線を消す</button>
    <span class="sf-hint">キャンバスをクリックで解曲線を追加</span>
  </div>
  <canvas id="sf-cv" width="360" height="360" class="sf-cv"></canvas>
  <figcaption id="sf-cap" class="sf-cap"></figcaption>
</figure>

<script>
  const eqs: Record<string, { f: (x: number, y: number) => number; note: string }> = {
    y:    { f: (x, y) => y, note: "y′=y の解は y=Ce^x（指数関数）。傾きが y に比例＝上ほど急。" },
    xmy:  { f: (x, y) => x - y, note: "y′=x−y。一階線形。解は直線 y=x−1 に漸近する。" },
    logi: { f: (x, y) => y * (1 - y), note: "ロジスティック方程式。y=0（不安定）と y=1（安定）が平衡解。個体数モデル。" },
    circ: { f: (x, y) => -x / y, note: "y′=−x/y の解は円 x²+y²=C（変数分離：y dy=−x dx）。y=0 で傾きが発散。" },
    xy:   { f: (x, y) => x * y, note: "y′=xy は変数分離形。解は y=Ce^{x²/2}。" },
    sinx: { f: (x, y) => Math.sin(x) - y, note: "y′=sin x − y。強制項つき一階線形。周期的な準定常解に落ち着く。" },
  };

  const sel = document.getElementById("sf-eq") as HTMLSelectElement | null;
  const clearBtn = document.getElementById("sf-clear");
  const cv = document.getElementById("sf-cv") as HTMLCanvasElement | null;
  const capEl = document.getElementById("sf-cap");

  if (sel && clearBtn && cv && capEl) {
    const ctx = cv.getContext("2d")!;
    const W = cv.width, H = cv.height, R = 4;
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || "#888";
    const px = (x: number) => (x + R) / (2 * R) * W;
    const py = (y: number) => H - (y + R) / (2 * R) * H;
    const ux = (X: number) => X / W * (2 * R) - R;
    const uy = (Y: number) => (H - Y) / H * (2 * R) - R;
    let seeds: [number, number][] = [];

    const curve = (f: (x: number, y: number) => number, x0: number, y0: number, dir: 1 | -1) => {
      const pts: [number, number][] = [[x0, y0]];
      let x = x0, y = y0; const h = 0.02 * dir;
      for (let i = 0; i < 1200; i++) {
        const k1 = f(x, y);
        const k2 = f(x + h / 2, y + h / 2 * k1);
        const k3 = f(x + h / 2, y + h / 2 * k2);
        const k4 = f(x + h, y + h * k3);
        const s = (k1 + 2 * k2 + 2 * k3 + k4) / 6;
        if (!isFinite(s) || Math.abs(s) > 1e4) break;
        x += h; y += h * s;
        if (Math.abs(x) > R + 1 || Math.abs(y) > R + 1) break;
        pts.push([x, y]);
      }
      return pts;
    };
    const stroke = (pts: [number, number][], color: string, w: number) => {
      ctx.strokeStyle = color; ctx.lineWidth = w; ctx.beginPath();
      pts.forEach(([x, y], i) => (i ? ctx.lineTo(px(x), py(y)) : ctx.moveTo(px(x), py(y))));
      ctx.stroke();
    };

    const render = () => {
      const { f, note } = eqs[sel.value];
      ctx.clearRect(0, 0, W, H);
      // 軸
      ctx.strokeStyle = css("--line"); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(px(-R), py(0)); ctx.lineTo(px(R), py(0)); ctx.moveTo(px(0), py(-R)); ctx.lineTo(px(0), py(R)); ctx.stroke();
      // 方向場
      ctx.strokeStyle = css("--ink-faint"); ctx.lineWidth = 1;
      const n = 19, L = 9;
      for (let i = 0; i <= n; i++) for (let j = 0; j <= n; j++) {
        const x = -R + 2 * R * i / n, y = -R + 2 * R * j / n;
        const s = f(x, y);
        if (!isFinite(s)) continue;
        const ang = Math.atan(s); const dx = Math.cos(ang) * L, dy = Math.sin(ang) * L;
        ctx.beginPath(); ctx.moveTo(px(x) - dx, py(y) + dy); ctx.lineTo(px(x) + dx, py(y) - dy); ctx.stroke();
      }
      // プリセットの解曲線（藍）
      const presets: [number, number][] = [[-3, 0.5], [-3, -0.5], [0, 1.5], [0, -1.5], [-2, 2], [2, -2]];
      for (const [x0, y0] of presets) { stroke(curve(f, x0, y0, 1), css("--ai"), 1.4); stroke(curve(f, x0, y0, -1), css("--ai"), 1.4); }
      // ユーザの解曲線（朱）
      for (const [x0, y0] of seeds) {
        stroke(curve(f, x0, y0, 1), css("--shu"), 2); stroke(curve(f, x0, y0, -1), css("--shu"), 2);
        ctx.fillStyle = css("--shu"); ctx.beginPath(); ctx.arc(px(x0), py(y0), 3, 0, 2 * Math.PI); ctx.fill();
      }
      capEl.innerHTML = note + " <b>藍＝代表的な解、朱＝クリックで追加した解</b>。どの解も、各点の傾き（灰の線分）に沿って進む。";
    };

    cv.addEventListener("click", (e) => {
      const r = cv.getBoundingClientRect();
      const X = (e.clientX - r.left) * (W / r.width), Y = (e.clientY - r.top) * (H / r.height);
      seeds.push([ux(X), uy(Y)]); render();
    });
    clearBtn.addEventListener("click", () => { seeds = []; render(); });
    sel.addEventListener("change", () => { seeds = []; render(); });
    render();
  }
</script>

<style>
  .sf { margin: 26px 0; padding: 16px 18px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .sf-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; margin-bottom: 12px; }
  .sf-label { font-size: 13px; font-weight: 600; color: var(--ink); font-family: var(--sans); }
  .sf-sel { font-family: var(--sans); font-size: 13px; padding: 4px 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper-sunk); color: var(--ink); margin-left: 4px; }
  .sf-btn { appearance: none; border: 1px solid var(--line); background: var(--paper-sunk); color: var(--ink); font-family: var(--sans); font-size: 12px; padding: 5px 12px; border-radius: 7px; cursor: pointer; }
  .sf-btn:hover { border-color: var(--shu); color: var(--shu); }
  .sf-hint { font-size: 11px; color: var(--ink-faint); font-family: var(--sans); }
  .sf-cv { display: block; margin: 0 auto; width: 100%; max-width: 340px; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-sunk); cursor: crosshair; }
  .sf-cap { margin-top: 12px; font-size: 13px; line-height: 1.8; color: var(--ink-faint); font-family: var(--sans); }
  .sf-cap b { color: var(--ink); font-weight: 700; }
</style>
