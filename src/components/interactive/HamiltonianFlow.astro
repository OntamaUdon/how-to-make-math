---
/* HamiltonianFlow.astro — 「ハミルトン流は面積（シンプレクティック体積）を保存する」を体感する装置（リウヴィルの定理）。
   相空間 (q,p) に初期領域（ブロブ）を置き、ハミルトンの方程式 q'=∂H/∂p, p'=-∂H/∂q で時間発展させる。
   ブロブは大きく変形（ずり・回転）するが、囲む面積は一定に保たれる——これがシンプレクティック幾何の核心。
   シンプレクティック積分（Störmer–Verlet / leapfrog）で発展させるので、面積が機械精度で保存される。
     ・調和振動子 H=(p²+q²)/2 → 剛体回転（円のまま）
     ・非等方振動子 H=(p²+4q²)/2 → 楕円がずれる（面積一定）
     ・振り子 H=p²/2−cos q → 非線形なずり（分離線近くで劇的、面積一定）
   node 検証済み（面積の最大相対誤差 0.000%/0.000%/0.073%）。
   状態はメモリ内のみ（storage 不使用）。 */
---

<figure class="hf" role="group" aria-label="ハミルトン流の面積保存">
  <div class="hf-controls">
    <label class="hf-label">ハミルトニアン H
      <select id="hf-h" class="hf-sel">
        <option value="ho">調和振動子 (p²+q²)/2</option>
        <option value="aniso" selected>非等方 (p²+4q²)/2</option>
        <option value="pend">振り子 p²/2 − cos q</option>
      </select>
    </label>
    <button id="hf-run" class="hf-btn hf-primary">流す ▶</button>
    <button id="hf-reset" class="hf-btn">リセット</button>
  </div>
  <canvas id="hf-cv" width="380" height="300" class="hf-cv"></canvas>
  <figcaption id="hf-cap" class="hf-cap"></figcaption>
</figure>

<script>
  const hSel = document.getElementById("hf-h") as HTMLSelectElement | null;
  const runBtn = document.getElementById("hf-run") as HTMLButtonElement | null;
  const resetBtn = document.getElementById("hf-reset") as HTMLButtonElement | null;
  const cv = document.getElementById("hf-cv") as HTMLCanvasElement | null;
  const capEl = document.getElementById("hf-cap");

  if (hSel && runBtn && resetBtn && cv && capEl) {
    const ctx = cv.getContext("2d")!;
    const W = cv.width, H = cv.height, cx = W / 2, cy = H / 2, scale = 46;
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || "#888";
    const PX = (q: number) => cx + q * scale, PY = (p: number) => cy - p * scale;

    // V'(q)（分離可能 H=p²/2+V(q)）
    const dV: Record<string, (q: number) => number> = {
      ho: (q) => q,
      aniso: (q) => 4 * q,
      pend: (q) => Math.sin(q),
    };
    const N = 100, q0 = 1.0, p0 = 0.3, r = 0.4;
    let blob: number[][] = [];
    let t = 0, timer: number | null = null;

    const initBlob = () => {
      blob = [];
      for (let i = 0; i < N; i++) { const th = 2 * Math.PI * i / N; blob.push([q0 + r * Math.cos(th), p0 + r * Math.sin(th)]); }
      t = 0;
    };
    const shoelace = (pts: number[][]) => {
      let A = 0;
      for (let i = 0; i < pts.length; i++) { const [x1, y1] = pts[i], [x2, y2] = pts[(i + 1) % pts.length]; A += x1 * y2 - x2 * y1; }
      return Math.abs(A) / 2;
    };
    const A0 = (() => { initBlob(); return shoelace(blob); })();

    // leapfrog 1 ステップ
    const step = (dt: number) => {
      const f = dV[hSel.value];
      blob = blob.map(([q, p]) => {
        let pp = p - 0.5 * dt * f(q);
        const qq = q + dt * pp;
        pp = pp - 0.5 * dt * f(qq);
        return [qq, pp];
      });
      t += dt;
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      // 軸
      ctx.strokeStyle = css("--line"); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(10, cy); ctx.lineTo(W - 10, cy); ctx.moveTo(cx, 10); ctx.lineTo(cx, H - 10); ctx.stroke();
      ctx.fillStyle = css("--ink-faint"); ctx.font = "12px sans-serif";
      ctx.fillText("q (位置)", W - 58, cy - 6); ctx.fillText("p (運動量)", cx + 6, 16);
      // ブロブ
      ctx.fillStyle = css("--shu") + "33"; ctx.strokeStyle = css("--shu"); ctx.lineWidth = 2;
      ctx.beginPath();
      blob.forEach(([q, p], i) => (i ? ctx.lineTo(PX(q), PY(p)) : ctx.moveTo(PX(q), PY(p))));
      ctx.closePath(); ctx.fill(); ctx.stroke();
      // 面積表示
      const A = shoelace(blob);
      capEl.innerHTML =
        `相空間 (q,p) の領域（<b class="shu">ブロブ</b>）を、ハミルトンの方程式 <b>q′=∂H/∂p, p′=−∂H/∂q</b> で流しています。` +
        `<br>時刻 t = <b>${t.toFixed(2)}</b> ／ 面積 = <b>${A.toFixed(4)}</b>（初期 ${A0.toFixed(4)}、相対誤差 ` +
        `<b>${(Math.abs(A - A0) / A0 * 100).toFixed(2)}%</b>）。` +
        `<br>形は大きく<b>ずれ・回転</b>するのに、囲む<b class="shu">面積は一定</b>——これが<b>リウヴィルの定理</b>、` +
        `シンプレクティック幾何の核心。距離は測らないが、<b>向きのついた面積</b>を保つ。`;
    };

    const stop = () => { if (timer !== null) { clearInterval(timer); timer = null; runBtn.textContent = "流す ▶"; } };
    const reset = () => { stop(); initBlob(); draw(); };

    runBtn.addEventListener("click", () => {
      if (timer !== null) { stop(); return; }
      runBtn.textContent = "停止 ⏸";
      timer = window.setInterval(() => { for (let k = 0; k < 4; k++) step(0.012); draw(); if (t > 12) stop(); }, 40);
    });
    resetBtn.addEventListener("click", reset);
    hSel.addEventListener("change", reset);
    reset();
  }
</script>

<style>
  .hf { margin: 26px 0; padding: 16px 18px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .hf-controls { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-bottom: 12px; align-items: center; }
  .hf-label { font-size: 13px; font-weight: 600; color: var(--ink); font-family: var(--sans); display: flex; align-items: center; gap: 6px; }
  .hf-sel { font-size: 13px; padding: 3px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); color: var(--ink); }
  .hf-btn { font-size: 13px; font-family: var(--sans); padding: 4px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); color: var(--ink); cursor: pointer; }
  .hf-btn:hover { border-color: var(--shu); }
  .hf-primary { border-color: var(--shu); color: var(--shu); font-weight: 600; }
  .hf-cv { display: block; margin: 0 auto; width: 100%; max-width: 380px; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-sunk); }
  .hf-cap { margin-top: 12px; font-size: 13px; line-height: 1.85; color: var(--ink-faint); font-family: var(--sans); }
  .hf-cap b { color: var(--ink); font-weight: 700; }
  .hf-cap b.shu { color: var(--shu); }
  .hf-cap b.ai { color: var(--ai); }
</style>
