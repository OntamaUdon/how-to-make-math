---
/* PhasePortrait.astro — 2次元線形系 x′=Ax の相図の体験装置。
   行列 A=[[a,b],[c,d]] のスライダーを動かすと、ベクトル場と軌道を描く。
   固有値（トレース T=a+d、行列式 D=ad−bc、判別式 T²−4D）から平衡点の型
   （結節点・鞍点・渦状点・中心）と安定性を判定する。
   「線形代数の固有値が力学系の運命を決める」を体感する。
   状態はメモリ内のみ（storage 不使用）。 */
---

<figure class="pp" role="group" aria-label="2次元線形系の相図">
  <div class="pp-controls">
    <div class="pp-mat">
      <span>A =</span>
      <div class="pp-grid2">
        <label>a<input id="pp-a" type="range" min="-2" max="2" step="0.1" value="-0.3" /><output id="pp-a-v">-0.3</output></label>
        <label>b<input id="pp-b" type="range" min="-2" max="2" step="0.1" value="1" /><output id="pp-b-v">1.0</output></label>
        <label>c<input id="pp-c" type="range" min="-2" max="2" step="0.1" value="-1" /><output id="pp-c-v">-1.0</output></label>
        <label>d<input id="pp-d" type="range" min="-2" max="2" step="0.1" value="-0.3" /><output id="pp-d-v">-0.3</output></label>
      </div>
    </div>
  </div>
  <canvas id="pp-cv" width="360" height="360" class="pp-cv"></canvas>
  <figcaption id="pp-cap" class="pp-cap"></figcaption>
</figure>

<script>
  const ids = ["a", "b", "c", "d"] as const;
  const inp = Object.fromEntries(ids.map((k) => [k, document.getElementById("pp-" + k) as HTMLInputElement | null]));
  const out = Object.fromEntries(ids.map((k) => [k, document.getElementById("pp-" + k + "-v")]));
  const cv = document.getElementById("pp-cv") as HTMLCanvasElement | null;
  const capEl = document.getElementById("pp-cap");

  if (cv && capEl && ids.every((k) => inp[k] && out[k])) {
    const ctx = cv.getContext("2d")!;
    const W = cv.width, H = cv.height, R = 4;
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim() || "#888";
    const px = (x: number) => (x + R) / (2 * R) * W;
    const py = (y: number) => H - (y + R) / (2 * R) * H;

    const traj = (a: number, b: number, c: number, d: number, x0: number, y0: number, dir: 1 | -1) => {
      const f = (x: number, y: number): [number, number] => [a * x + b * y, c * x + d * y];
      const pts: [number, number][] = [[x0, y0]]; let x = x0, y = y0; const h = 0.03 * dir;
      for (let i = 0; i < 800; i++) {
        const [k1x, k1y] = f(x, y);
        const [k2x, k2y] = f(x + h / 2 * k1x, y + h / 2 * k1y);
        const [k3x, k3y] = f(x + h / 2 * k2x, y + h / 2 * k2y);
        const [k4x, k4y] = f(x + h * k3x, y + h * k3y);
        x += h / 6 * (k1x + 2 * k2x + 2 * k3x + k4x);
        y += h / 6 * (k1y + 2 * k2y + 2 * k3y + k4y);
        if (Math.abs(x) > R + 1 || Math.abs(y) > R + 1 || !isFinite(x) || !isFinite(y)) break;
        pts.push([x, y]);
      }
      return pts;
    };
    const stroke = (pts: [number, number][], color: string, w: number) => {
      ctx.strokeStyle = color; ctx.lineWidth = w; ctx.beginPath();
      pts.forEach(([x, y], i) => (i ? ctx.lineTo(px(x), py(y)) : ctx.moveTo(px(x), py(y)))); ctx.stroke();
    };

    const classify = (T: number, D: number) => {
      const disc = T * T - 4 * D;
      if (Math.abs(D) < 1e-9) return { name: "退化（平衡点が直線状）", stab: "", ev: "" };
      if (D < 0) return { name: "鞍点（saddle）", stab: "不安定", ev: `実固有値 λ=${((T + Math.sqrt(disc)) / 2).toFixed(2)}, ${((T - Math.sqrt(disc)) / 2).toFixed(2)}（異符号）` };
      if (disc >= 0) {
        const l1 = (T + Math.sqrt(disc)) / 2, l2 = (T - Math.sqrt(disc)) / 2;
        return { name: "結節点（node）", stab: T < 0 ? "安定" : "不安定", ev: `実固有値 λ=${l1.toFixed(2)}, ${l2.toFixed(2)}（同符号）` };
      }
      const re = T / 2, im = Math.sqrt(-disc) / 2;
      if (Math.abs(T) < 1e-9) return { name: "中心（center）", stab: "中立（周回）", ev: `純虚固有値 λ=±${im.toFixed(2)}i` };
      return { name: "渦状点（spiral / focus）", stab: T < 0 ? "安定" : "不安定", ev: `複素固有値 λ=${re.toFixed(2)}±${im.toFixed(2)}i` };
    };

    const render = () => {
      const a = +inp.a!.value, b = +inp.b!.value, c = +inp.c!.value, d = +inp.d!.value;
      ids.forEach((k) => (out[k]!.textContent = (+inp[k]!.value).toFixed(1)));
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = css("--line"); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(px(-R), py(0)); ctx.lineTo(px(R), py(0)); ctx.moveTo(px(0), py(-R)); ctx.lineTo(px(0), py(R)); ctx.stroke();
      // ベクトル場（正規化した矢印）
      ctx.strokeStyle = css("--ink-faint");
      const n = 13;
      for (let i = 0; i <= n; i++) for (let j = 0; j <= n; j++) {
        const x = -R + 2 * R * i / n, y = -R + 2 * R * j / n;
        let vx = a * x + b * y, vy = c * x + d * y; const m = Math.hypot(vx, vy) || 1;
        vx = vx / m * 8; vy = vy / m * 8;
        const X = px(x), Y = py(y);
        ctx.beginPath(); ctx.moveTo(X, Y); ctx.lineTo(X + vx, Y - vy); ctx.stroke();
        ctx.beginPath(); ctx.arc(X + vx, Y - vy, 1.3, 0, 2 * Math.PI); ctx.fillStyle = css("--ink-faint"); ctx.fill();
      }
      // 軌道（円周上の種から前後に積分）
      for (let k = 0; k < 16; k++) {
        const th = 2 * Math.PI * k / 16, x0 = 3.6 * Math.cos(th), y0 = 3.6 * Math.sin(th);
        stroke(traj(a, b, c, d, x0, y0, 1), css("--ai"), 1.3);
        stroke(traj(a, b, c, d, x0, y0, -1), css("--shu"), 1.3);
      }
      ctx.fillStyle = css("--ink"); ctx.beginPath(); ctx.arc(px(0), py(0), 3.5, 0, 2 * Math.PI); ctx.fill();

      const T = a + d, D = a * d - b * c; const cl = classify(T, D);
      capEl.innerHTML = `トレース T=${T.toFixed(2)}, 行列式 D=${D.toFixed(2)}。${cl.ev}。` +
        ` 平衡点（原点）は <b>${cl.name}</b>${cl.stab ? "・<b>" + cl.stab + "</b>" : ""}。` +
        ` <b>固有値の符号・実虚が軌道の運命を決める</b>（藍＝前向き、朱＝後ろ向きの流れ）。`;
    };

    ids.forEach((k) => inp[k]!.addEventListener("input", render));
    render();
  }
</script>

<style>
  .pp { margin: 26px 0; padding: 16px 18px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .pp-controls { margin-bottom: 12px; }
  .pp-mat { display: flex; align-items: center; gap: 12px; font-family: var(--serif); font-weight: 700; }
  .pp-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; }
  .pp-grid2 label { display: flex; align-items: center; gap: 8px; font-size: 13px; font-family: var(--sans); font-weight: 600; color: var(--ink); }
  .pp-grid2 input { width: 92px; accent-color: var(--shu); }
  .pp-grid2 output { width: 30px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .pp-cv { display: block; margin: 0 auto; width: 100%; max-width: 340px; height: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-sunk); }
  .pp-cap { margin-top: 12px; font-size: 13px; line-height: 1.8; color: var(--ink-faint); font-family: var(--sans); }
  .pp-cap b { color: var(--ink); font-weight: 700; }
</style>
